[node name="HelpText" type="Label" parent="HelpPanel/Center/Panel/VBox" unique_id=654916135]
layout_mode = 2
theme_override_colors/font_color = Color(0.69803923, 0.69803923, 0.69803923, 0.78)
theme_override_font_sizes/font_size = 20
text = "Take turns dropping your mark on the board. Three in a row wins the round: across, down or corner to corner.

Turn on INFINITE MODE and the board never fills up. Each player keeps only three marks on the table, so the fourth one you place pushes your oldest one off. Nothing is ever safe and no game ever ends in a draw.

Every mark is drawn faded by how soon it goes, so the whole board can be read at a glance: the faintest one is the next to leave.

Whoever wins enough rounds takes the match."
autowrap_mode = 3

